@{ ViewData["Title"] = "Log in"; }
<section class="dynamic-page"><div class="section-kicker">WELCOME BACK</div><h1>Ready for the next step?</h1><p class="page-lead">Log in to see your saved plans and bookings.</p><form class="form-card" data-auth-form="login"><div class="form-grid"><div class="form-field full"><label>Email address</label><input name="email" type="email" required autocomplete="email"/></div><div class="form-field full"><label>Password</label><input name="password" type="password" required autocomplete="current-password"/></div></div><button class="button button-dark">Log in <span>↗</span></button><p class="api-hint">New here? <a href="/register">Create an account</a></p></form></section>
