@{ ViewData["Title"] = "Create an account"; }
<section class="dynamic-page"><div class="section-kicker">YOUR NEXT CHAPTER STARTS HERE</div><h1>Make room for a new chapter.</h1><p class="page-lead">Create a student or mentor account to get started.</p><form class="form-card" data-auth-form="register"><div class="form-grid"><div class="form-field full"><label>Your name</label><input name="name" required maxlength="120" autocomplete="name"/></div><div class="form-field full"><label>Email address</label><input name="email" type="email" required autocomplete="email"/></div><div class="form-field full"><label>Password (at least 8 characters)</label><input name="password" type="password" required minlength="8" autocomplete="new-password"/></div><div class="form-field full"><label>I’m joining as</label><select name="role"><option value="Student">Student</option><option value="Mentor">Mentor</option></select></div></div><button class="button button-dark">Create account <span>↗</span></button><p class="api-hint">Already have an account? <a href="/login">Log in</a></p></form></section>
