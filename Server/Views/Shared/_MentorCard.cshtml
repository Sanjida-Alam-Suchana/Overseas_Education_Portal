@model MentorCardModel
<article class="mentor-card"><div class="mentor-cover"><img src="https://images.unsplash.com/photo-1517935706615-2717063c2225?auto=format&fit=crop&w=700&q=80" alt="Study destination"/><span class="mentor-avatar initials">@Model.Name.Split(' ').Select(x => x[0]).Take(2).Aggregate("", (a, c) => a + c)</span></div><div class="mentor-body"><h3>@Model.Name</h3><div class="university">@Model.University · @Model.Country</div><div class="mentor-tags"><span class="tag">@Model.Program</span><span class="tag">@Model.Service</span></div><div class="mentor-bottom"><div class="mentor-rating">★ @Model.Rating <span>(@Model.Sessions sessions)</span></div><a href="/mentor/@Model.Id">View profile ↗</a></div></div></article>
