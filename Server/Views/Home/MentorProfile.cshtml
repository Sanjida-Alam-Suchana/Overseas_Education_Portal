@{ ViewData["Title"] = "Mentor profile"; }
<section class="dynamic-page"><div class="section-kicker">YOUR ABROADMATES PROFILE</div><h1>Your mentor profile</h1><p class="page-lead">Share your experience and set the prices for your 20 and 40 minute calls.</p><form class="form-card" id="profile-form"><div class="form-grid"><div class="form-field"><label>Your name</label><input name="name" required/></div><div class="form-field"><label>Country</label><select id="profile-country" name="country" required><option value="">Choose country</option><option>Australia</option><option>Canada</option><option>United Kingdom</option><option>United States</option><option>Germany</option></select></div><div class="form-field"><label>University</label><select id="profile-university" name="university" required><option>Select a country first</option></select></div><div class="form-field"><label>Program</label><input name="program" required/></div><div class="form-field"><label>Service</label><input name="service" placeholder="Application review" required/></div><div class="form-field"><label>Scholarship (optional)</label><input name="scholarship"/></div><div class="form-field"><label>20 minute price (USD)</label><input name="price20" type="number" min="0" value="20" required/></div><div class="form-field"><label>40 minute price (USD)</label><input name="price40" type="number" min="0" value="35" required/></div><div class="form-field full"><label>About you</label><textarea name="bio" required maxlength="2000"></textarea></div></div><button class="button button-dark">Save profile</button></form><div class="form-card"><h2>Profile files</h2><div class="upload-row"><input id="file-photo" type="file" accept="image/png,image/jpeg,image/webp"/><button type="button" class="outline-button" data-upload="photo">Upload photo</button><a class="text-link" href="#" onclick="this.href='/api/mentors/'+JSON.parse(localStorage.getItem('abroadmates-user')||'{}').id+'/files/photo'">View</a></div><div class="upload-row"><input id="file-cv" type="file" accept="application/pdf"/><button type="button" class="outline-button" data-upload="cv">Upload CV</button><a class="text-link" href="#" onclick="this.href='/api/mentors/'+JSON.parse(localStorage.getItem('abroadmates-user')||'{}').id+'/files/cv'">Download CV</a></div></div></section>
