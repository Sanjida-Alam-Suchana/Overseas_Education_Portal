@model IReadOnlyList<Scholarship>
@{ ViewData["Title"] = "Scholarship mentors"; }
<section class="dynamic-page"><div class="section-kicker">MAKE YOUR DREAM MORE POSSIBLE</div><h1>Scholarship mentors</h1><p class="page-lead">Talk to students who have navigated competitive scholarships and can share what helped.</p><div class="scholar-grid">@foreach(var scholarship in Model){<a class="scholar-card" href="/find-mentor?scholarship=@Uri.EscapeDataString(scholarship.Name)"><span class="scholar-mark">@scholarship.Name.Substring(0,Math.Min(2,scholarship.Name.Length)).ToUpperInvariant()</span><div><b>@scholarship.Name</b><small>@(scholarship.Country?.Name ?? "International") · View mentors</small></div><span>↗</span></a>}</div>@if(Model.Count==0){<div class="empty-state">Scholarship listings are being prepared.</div>}</section>
