@model MentorCardModel
@{ ViewData["Title"] = Model.Name; }
<section class="dynamic-page"><div class="section-kicker">YOUR ABROADMATE</div><h1>@Model.Name</h1><p class="page-lead">@Model.University · @Model.Country · ★ @Model.Rating (@Model.Sessions sessions)</p><p class="mentor-bio">@Model.Bio</p><div class="mentor-tags"><span class="tag">@Model.Program</span><span class="tag">@Model.Service</span></div><form class="form-card" data-mentor-id="@Model.Id"><h2>Book a call</h2><div class="form-grid"><div class="form-field"><label>Call length</label><select name="minutes">@foreach(var plan in Model.Plans){<option value="@plan.Minutes">@plan.Minutes minutes · $@plan.Price</option>}</select></div><div class="form-field"><label>Date</label><input name="date" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" required/></div><div class="form-field"><label>Time</label><input name="time" type="time" required/></div></div><button type="button" class="button button-dark" data-book-mentor>Request this call <span>↗</span></button></form></section>
