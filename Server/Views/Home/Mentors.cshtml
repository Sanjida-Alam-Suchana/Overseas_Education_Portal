@model MentorDirectoryPageModel
@{ ViewData["Title"] = Model.Country is null ? "Find a mentor" : $"Study in {Model.Country}"; }
<section class="dynamic-page"><div class="section-kicker">ABROADMATES</div><h1>@ViewData["Title"]</h1><p class="page-lead">@Model.Intro</p>
<form class="filter-panel" method="get" action="/find-mentor"><input name="search" placeholder="Name or university"/><select name="country"><option value="">All countries</option>@foreach(var x in Model.Countries){<option selected="@(x == Model.Country)" value="@x">@x</option>}</select><select name="program"><option value="">All programs</option>@foreach(var x in Model.Programs){<option value="@x">@x</option>}</select><select name="service"><option value="">All services</option>@foreach(var x in Model.Services){<option value="@x">@x</option>}</select><select name="scholarship"><option value="">All scholarships</option>@foreach(var x in Model.Scholarships){<option value="@x">@x</option>}</select><select name="sort"><option value="rating">Top rated</option><option value="sessions">Most sessions</option><option value="price">Price low to high</option></select><button class="button button-dark button-small">Search</button></form>
<div class="action-row"><a class="outline-button" href="/api/exports/mentors.csv">Download Excel-compatible CSV</a><a class="outline-button" href="/api/exports/mentors.pdf" target="_blank">Print / export PDF</a></div><div class="mentor-grid">@if(Model.Mentors.Count == 0){<div class="empty-state">No mentors match these filters.</div>} @foreach(var mentor in Model.Mentors){<partial name="_MentorCard" model="mentor"/>}</div></section>
