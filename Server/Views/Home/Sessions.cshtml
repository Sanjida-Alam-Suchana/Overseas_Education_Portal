@model IReadOnlyList<GroupSessionCardModel>
@{ ViewData["Title"] = "Group sessions"; }
<section class="dynamic-page"><div class="section-kicker">BETTER TOGETHER</div><h1>Big questions. Good company.</h1><p class="page-lead">Join a friendly live session with mentors and students on the same journey.</p><div class="tabs"><a class="tab active" href="/group-sessions">Upcoming sessions</a><a class="tab" href="/group-sessions?phase=past">Past sessions</a></div><form method="get" class="filter-panel" style="grid-template-columns:1fr"><select name="category"><option value="">All categories</option><option>Scholarships</option><option>Student life</option><option>Applications</option></select><button class="outline-button">Filter</button></form><div class="session-list">@foreach(var item in Model){<article class="session-card"><span class="category">@item.Category · @item.StartsAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</span><h3>@item.Title</h3><p>@item.Description</p><p>Hosted by @item.Host · @item.Attendees students going</p>@if(item.StartsAt > DateTime.UtcNow){<button class="button button-dark" data-register-session="@item.Id">Save my seat ↗</button>}else{<span class="tag">Session ended</span>}</article>}</div>@if(Model.Count==0){<div class="empty-state">No sessions in this list just yet.</div>}</section>
